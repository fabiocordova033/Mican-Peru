# Copia este archivo como .env.local y completa con los datos de tu app web de Firebase
# (Consola de Firebase > Configuración del proyecto > Tus apps > Web).
VITE_USAR_EMULADORES=false
VITE_FIREBASE_PROJECT_ID=mican-peru-dev
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=mican-peru-dev.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=mican-peru-dev.appspot.com
VITE_FIREBASE_APP_ID=
