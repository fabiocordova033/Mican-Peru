# Copia a functions/.secret.local para usar el emulador (no se sube a git).
# Pasarela simulada: cualquier texto. Mercado Pago: la "clave secreta" de Webhooks.
PAGOS_WEBHOOK_SECRET=secreto-de-prueba
# Access token de Mercado Pago (credenciales de prueba: TEST-... o de un usuario de prueba).
# Con PASARELA=simulada no se usa, pero debe existir.
MP_ACCESS_TOKEN=sin-configurar
