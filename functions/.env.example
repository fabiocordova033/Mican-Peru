# Copia este archivo a functions/.env.local para el emulador.
# Pasarela de pago: "simulada" (desarrollo, sin cuenta) | "mercadopago"
PASARELA=simulada
# Mercado Pago: "sandbox" (checkout de prueba) | "produccion" (cobra de verdad)
MP_MODO=sandbox
# URL pública de la función webhookPagos (se envía a MP como notification_url).
# Ej.: https://southamerica-east1-<proyecto>.cloudfunctions.net/webhookPagos
PAGOS_URL_WEBHOOK=
# Opcional: página a la que vuelve el usuario después de pagar.
PAGOS_URL_RETORNO=
# Correo de contacto de privacidad que se muestra en "Privacidad y mis datos"
CORREO_PRIVACIDAD=privacidad@mican.pe
# Los secretos (clave de webhook, access token de la pasarela) NO van aquí:
#   firebase functions:secrets:set PAGOS_WEBHOOK_SECRET
#   firebase functions:secrets:set MP_ACCESS_TOKEN
# En el emulador se leen de functions/.secret.local

# Datos del proveedor que la ley pide mostrar (HU-31). Completar al constituir la empresa.
EMPRESA_RAZON_SOCIAL=Mican Peru S.A.C.
EMPRESA_RUC=00000000000
EMPRESA_DOMICILIO=Lima, Perú
# Teléfono de soporte que se ofrece en el botón de emergencia (HU-18)
TELEFONO_SOPORTE=+51900000000
